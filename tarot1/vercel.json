{
    "version": 2,
    "builds": [
      {
        "src": "package.json",  
        "use": "@vercel/static-build"
      },
      {
        "src": "backend/index.js",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/api/interpretar",
        "dest": "/backend/index.js"
      },
      {
        "src": "/(.*)",
        "dest": "/$1"
      }
    ]
  }
  